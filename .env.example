# ─────────────────────────────────────────────
#  DealFlow360 — Root Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env in the relevant package directory.
# Each package (backend/, frontend/) has its own .env.example.
#
# Backend env vars → see backend/.env.example
# Frontend env vars → see frontend/.env.example

# MongoDB (shared reference)
MONGO_URI=mongodb://localhost:27017/dealflow360

# JWT Secrets (backend only)
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret

# Server
PORT=5000
