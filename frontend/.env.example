# ─────────────────────────────────────────────
#  DealFlow360 — Frontend Environment Variables
# ─────────────────────────────────────────────
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# API base URL — Vite proxy handles this in development (see vite.config.js)
# Only set this if you are NOT using the Vite proxy (e.g. serving the built bundle)
# VITE_API_BASE_URL=http://localhost:5000/api
